import java.util.*;

public class Main {
    static final int MOD = 1_000_000_007;
    static long[][] comb;

    public static int numOfWays(int[] nums) {
        int n = nums.length;
        comb = new long[n + 1][n + 1];

        for (int i = 0; i <= n; i++) {
            comb[i][0] = comb[i][i] = 1;
            for (int j = 1; j < i; j++) {
                comb[i][j] = (comb[i - 1][j - 1] + comb[i - 1][j]) % MOD;
            }
        }

        List<Integer> list = new ArrayList<>();
        for (int num : nums) {
            list.add(num);
        }

        return (int) ((dfs(list) - 1 + MOD) % MOD);
    }

    static long dfs(List<Integer> nums) {
        int n = nums.size();

        if (n <= 2) {
            return 1;
        }

        int root = nums.get(0);
        List<Integer> left = new ArrayList<>();
        List<Integer> right = new ArrayList<>();

        for (int i = 1; i < n; i++) {
            int num = nums.get(i);
            if (num < root) {
                left.add(num);
            } else {
                right.add(num);
            }
        }

        long leftWays = dfs(left);
        long rightWays = dfs(right);

        return comb[n - 1][left.size()] * leftWays % MOD * rightWays % MOD;
    }

    public static void main(String[] args) {
        int[] nums = {3, 4, 5, 1, 2};
        System.out.println(numOfWays(nums));
    }
}
